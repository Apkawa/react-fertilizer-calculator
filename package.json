{
  "name": "fertilizer-calculator",
  "private": true,
  "scripts": {
    "preversion": "pnpm full-check",
    "full-check": "pnpm test && pnpm lint && pnpm type && pnpm build",
    "start": "pnpm -C apps/web start",
    "build": "pnpm -C apps/web build",
    "test": "pnpm -C packages/calculator test && pnpm -C packages/icons test && pnpm -C packages/ui test && pnpm -C apps/web test",
    "test:e2e": "playwright test tests/e2e",
    "test:smoke": "playwright test tests/smoke",
    "lint": "biome check apps packages --diagnostic-level=error",
    "type": "tsc -p packages/calculator && tsc -p packages/icons && tsc -p packages/ui && tsc -p apps/web",
    "analyze": "pnpm build && source-map-explorer 'apps/web/build/assets/*.js'",
    "jupyter": "jupyter-notebook docs/"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm full-check"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "husky": "^4.3.0",
    "source-map-explorer": "^2.5.0",
    "ts-node": "^9.0.0",
    "typescript": "7.0.2",
    "typesync": "^0.7.0"
  },
  "packageManager": "pnpm@11.22.0"
}
