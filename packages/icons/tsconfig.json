{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["esnext", "dom"],
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react",
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "./src/**/*",
    "./types/**/*",
    // @fertilizer/ui — source-пакет: амбиентная декларация .css-импортов входит в программу.
    "../ui/src/**/*.d.ts"
  ]
}
